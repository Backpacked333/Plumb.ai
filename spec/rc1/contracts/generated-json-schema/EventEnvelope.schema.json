{
  "$id": "https://plumb.example/schemas/EventEnvelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_id": {
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_type": {
      "title": "Aggregate Type",
      "type": "string"
    },
    "aggregate_version": {
      "minimum": 1,
      "title": "Aggregate Version",
      "type": "integer"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Ref"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "tombstone": {
      "default": false,
      "title": "Tombstone",
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "event_type",
    "schema_version",
    "occurred_at",
    "recorded_at",
    "correlation_id"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
