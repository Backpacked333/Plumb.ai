{
  "$id": "https://plumb.example/schemas/ErrorEnvelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "AUTH_REQUIRED",
        "SCOPE_DENIED",
        "PURPOSE_DENIED",
        "POLICY_STALE",
        "STATE_CONFLICT",
        "PAYLOAD_CONFLICT",
        "BUDGET_EXCEEDED",
        "CAPABILITY_UNSUPPORTED",
        "SOURCE_STALE",
        "DATA_QUALITY_FAILED",
        "VERIFICATION_FAILED",
        "EFFECT_UNKNOWN",
        "RETRY_EXHAUSTED",
        "VALIDATION_FAILED",
        "NOT_FOUND",
        "RATE_LIMITED"
      ],
      "title": "Code",
      "type": "string"
    },
    "dependency_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dependency Id"
    },
    "details": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Details",
      "type": "array"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "operator_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operator Action"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
