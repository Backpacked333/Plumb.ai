{
  "$defs": {
    "MoneyAmount": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "description": "ISO 4217 code",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "minor_units": {
          "description": "Integer amount in the currency's minor unit (cents for USD)",
          "title": "Minor Units",
          "type": "integer"
        }
      },
      "required": [
        "minor_units",
        "currency"
      ],
      "title": "MoneyAmount",
      "type": "object"
    }
  },
  "$id": "https://plumb.example/schemas/BudgetReservation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_no": {
      "minimum": 1,
      "title": "Attempt No",
      "type": "integer"
    },
    "build_id": {
      "title": "Build Id",
      "type": "string"
    },
    "reservation_id": {
      "title": "Reservation Id",
      "type": "string"
    },
    "reserved": {
      "$ref": "#/$defs/MoneyAmount"
    },
    "settled": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyAmount"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "reserved",
      "enum": [
        "reserved",
        "settled",
        "released"
      ],
      "title": "Status",
      "type": "string"
    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "reservation_id",
    "tenant_id",
    "build_id",
    "step_id",
    "attempt_no",
    "reserved"
  ],
  "title": "BudgetReservation",
  "type": "object"
}
