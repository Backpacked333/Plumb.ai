{
  "$defs": {
    "FactStatus": {
      "enum": [
        "observed",
        "inferred",
        "confirmed",
        "disputed",
        "stale",
        "superseded"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Reference to an artifact or record. Artifacts consumed by a run MUST carry a digest (SR-031).",
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mutable alias the ref was resolved from, if any",
          "title": "Alias"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "platform: sha256 of canonical bytes",
          "title": "Digest"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "object_type": {
          "pattern": "^[A-Za-z]{3,40}$",
          "title": "Object Type",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "https://plumb.example/schemas/Fact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "derivation_version": {
      "title": "Derivation Version",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "fact_id": {
      "title": "Fact Id",
      "type": "string"
    },
    "predicate": {
      "title": "Predicate",
      "type": "string"
    },
    "source_of_record": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "provider that is authoritative for this predicate",
      "title": "Source Of Record"
    },
    "status": {
      "$ref": "#/$defs/FactStatus"
    },
    "subject": {
      "$ref": "#/$defs/Ref"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "value": {
      "title": "Value"
    }
  },
  "required": [
    "fact_id",
    "tenant_id",
    "subject",
    "predicate",
    "value",
    "status",
    "evidence",
    "derivation_version"
  ],
  "title": "Fact",
  "type": "object"
}
