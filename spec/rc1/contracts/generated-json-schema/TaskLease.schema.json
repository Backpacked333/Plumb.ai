{
  "$id": "https://plumb.example/schemas/TaskLease.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "fencing_token": {
      "description": "platform: monotonically increasing per task",
      "minimum": 1,
      "title": "Fencing Token",
      "type": "integer"
    },
    "lease_id": {
      "title": "Lease Id",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "task_id",
    "worker_id",
    "fencing_token",
    "acquired_at",
    "expires_at"
  ],
  "title": "TaskLease",
  "type": "object"
}
