{
  "$defs": {
    "DecisionKind": {
      "description": "The three distinct decisions an owner or reviewer can make (PL-041).",
      "enum": [
        "DATA_USE",
        "IMPLEMENT_OPERATE",
        "CASE_LEVEL_BUSINESS"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "An authenticated acting principal.",
      "properties": {
        "authenticated_via": {
          "description": "Authentication mechanism reference (e.g. oidc:issuer), never a secret (PL-054).",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Authenticated Via",
          "type": "string"
        },
        "principal_id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/PrincipalType"
        }
      },
      "required": [
        "principal_id",
        "principal_type",
        "authenticated_via"
      ],
      "title": "Principal",
      "type": "object"
    },
    "PrincipalType": {
      "enum": [
        "HUMAN_OWNER",
        "HUMAN_REVIEWER",
        "HUMAN_APPROVER",
        "SERVICE",
        "BUILD_AGENT",
        "RUNTIME_AGENT",
        "VERIFIER",
        "RELEASE_EXECUTOR"
      ],
      "title": "PrincipalType",
      "type": "string"
    }
  },
  "$id": "https://plumb.example/schemas/0.2/ApprovalRecord.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A human decision bound to exactly one digest, case version, policy version and tenant (PL-040).",
  "properties": {
    "approval_id": {
      "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
      "title": "Approval Id",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "approver": {
      "$ref": "#/$defs/Principal",
      "description": "The human who decided; never a build or runtime agent."
    },
    "artifact_id": {
      "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "authenticated_decision_ref": {
      "description": "Reference to the independently authenticated decision (e.g. an identity-provider event).",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Authenticated Decision Ref",
      "type": "string"
    },
    "case_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Case version approved; required for CASE_LEVEL_BUSINESS decisions.",
      "title": "Case Version"
    },
    "content_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Digest"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_kind": {
      "$ref": "#/$defs/DecisionKind"
    },
    "evidence_links": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
        "type": "string"
      },
      "title": "Evidence Links",
      "type": "array"
    },
    "expires_at": {
      "description": "Instant from which the approval no longer authorizes anything.",
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "kind": {
      "const": "ApprovalRecord",
      "default": "ApprovalRecord",
      "title": "Kind",
      "type": "string"
    },
    "policy_version": {
      "description": "Policy version in force when the decision was made.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Policy Version",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Principal"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Instant of revocation; cached grants and queued dispatches are invalid from here.",
      "title": "Revoked At"
    },
    "schema_version": {
      "default": "0.2.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_tenant": {
      "description": "Tenant the approval is valid for; must equal tenant_id.",
      "pattern": "^tnt_[a-z0-9]{4,32}$",
      "title": "Scope Tenant",
      "type": "string"
    },
    "subject_digest": {
      "description": "Digest of the artifact or action payload this approval authorizes; nothing else.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Subject Digest",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^tnt_[a-z0-9]{4,32}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "version": {
      "description": "Immutable version number of this artifact id.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "version",
    "producer",
    "created_at",
    "approval_id",
    "decision_kind",
    "subject_digest",
    "policy_version",
    "approver",
    "authenticated_decision_ref",
    "approved_at",
    "expires_at",
    "scope_tenant"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}
