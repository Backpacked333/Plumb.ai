{
  "$defs": {
    "EffectClass": {
      "description": "What an operation may do to the world. Envelopes allow a subset (PL-005).",
      "enum": [
        "READ",
        "INTERNAL_WRITE",
        "EXTERNAL_WRITE_REVERSIBLE",
        "EXTERNAL_WRITE_IRREVERSIBLE",
        "EXTERNAL_COMMUNICATION",
        "FINANCIAL_COMMITMENT",
        "INFRASTRUCTURE_CHANGE",
        "DESTRUCTIVE"
      ],
      "title": "EffectClass",
      "type": "string"
    },
    "EffectSlot": {
      "additionalProperties": false,
      "description": "The semantic identity of one business action (PL-037, PL-039).\n\nTwo intents with the same slot are the *same* business action regardless of\ntheir payload, their release or the worker that produced them. A deliberate\nnew action for the same obligation belongs to a new ``obligation_epoch``.",
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "title": "Case Id",
          "type": "string"
        },
        "obligation_epoch": {
          "description": "Approved epoch of the obligation; a new approved action increments it.",
          "minimum": 0,
          "title": "Obligation Epoch",
          "type": "integer"
        },
        "obligation_id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "title": "Obligation Id",
          "type": "string"
        },
        "operation": {
          "description": "Operation performed, e.g. send_reminder or post_journal.",
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "description": "Provider account / recipient identity the effect lands on.",
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "title": "Target",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^tnt_[a-z0-9]{4,32}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "case_id",
        "obligation_id",
        "obligation_epoch",
        "operation",
        "target"
      ],
      "title": "EffectSlot",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "An authenticated acting principal.",
      "properties": {
        "authenticated_via": {
          "description": "Authentication mechanism reference (e.g. oidc:issuer), never a secret (PL-054).",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Authenticated Via",
          "type": "string"
        },
        "principal_id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "title": "Principal Id",
          "type": "string"
        },
        "principal_type": {
          "$ref": "#/$defs/PrincipalType"
        }
      },
      "required": [
        "principal_id",
        "principal_type",
        "authenticated_via"
      ],
      "title": "Principal",
      "type": "object"
    },
    "PrincipalType": {
      "enum": [
        "HUMAN_OWNER",
        "HUMAN_REVIEWER",
        "HUMAN_APPROVER",
        "SERVICE",
        "BUILD_AGENT",
        "RUNTIME_AGENT",
        "VERIFIER",
        "RELEASE_EXECUTOR"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A reference to an authorized external source/account. Never carries credentials.",
      "properties": {
        "external_account_id": {
          "description": "Provider-assigned account identity (opaque, non-secret).",
          "maxLength": 256,
          "minLength": 1,
          "title": "External Account Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resource within the account, e.g. mailbox or ledger name.",
          "title": "Resource"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "provider",
        "external_account_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$id": "https://plumb.example/schemas/0.2/ActionIntent.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Persisted intent to perform one external effect (PL-037).",
  "properties": {
    "action_id": {
      "description": "Logical action id; stable across retries of the same action.",
      "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
      "title": "Action Id",
      "type": "string"
    },
    "artifact_id": {
      "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "authority_ref": {
      "description": "Approval or envelope that authorizes this effect.",
      "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
      "title": "Authority Ref",
      "type": "string"
    },
    "content_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Digest"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deployment_version": {
      "description": "Release id that prepared the action; not part of the identity.",
      "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
      "title": "Deployment Version",
      "type": "string"
    },
    "effect_class": {
      "$ref": "#/$defs/EffectClass"
    },
    "evidence_links": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
        "type": "string"
      },
      "title": "Evidence Links",
      "type": "array"
    },
    "expected_state_version": {
      "description": "Case state version the action was prepared/approved against (section 15); cases start at 1.",
      "minimum": 1,
      "title": "Expected State Version",
      "type": "integer"
    },
    "idempotency_key": {
      "description": "Must equal derive_idempotency_key(action_id, slot); never derived from the payload.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "kind": {
      "const": "ActionIntent",
      "default": "ActionIntent",
      "title": "Kind",
      "type": "string"
    },
    "payload_digest": {
      "description": "Digest of the exact payload to be sent; stored apart from the slot.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Payload Digest",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Principal"
    },
    "provider_target": {
      "$ref": "#/$defs/SourceRef"
    },
    "schema_version": {
      "default": "0.2.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "slot": {
      "$ref": "#/$defs/EffectSlot"
    },
    "supersedes_action_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.:/-]{0,159}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Explicit supersession decision: the settled action on the same slot this one replaces.",
      "title": "Supersedes Action Id"
    },
    "tenant_id": {
      "pattern": "^tnt_[a-z0-9]{4,32}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "version": {
      "description": "Immutable version number of this artifact id.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "version",
    "producer",
    "created_at",
    "action_id",
    "slot",
    "payload_digest",
    "expected_state_version",
    "authority_ref",
    "deployment_version",
    "provider_target",
    "effect_class",
    "idempotency_key"
  ],
  "title": "ActionIntent",
  "type": "object"
}
